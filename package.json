{
  "name": "@liucong233333/pi-bettergoal",
  "version": "0.3.1",
  "description": "Enhanced Pi goals with model-selected wait/wake hooks, built on Michaelliv/pi-goal. Conflicts with pi-goal; do not load both.",
  "homepage": "https://github.com/Liucong-JunZi/pi-bettergoal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liucong-JunZi/pi-bettergoal.git"
  },
  "bugs": {
    "url": "https://github.com/Liucong-JunZi/pi-bettergoal/issues"
  },
  "upstream": "https://github.com/Michaelliv/pi-goal",
  "type": "commonjs",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "goal",
    "automation"
  ],
  "files": [
    ".pi/",
    "skills/",
    "README.md",
    "README.zh-CN.md",
    "HOOKS.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      ".pi/extensions/pi-goal"
    ],
    "skills": [
      "skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  },
  "scripts": {
    "check": "pi --no-extensions -e ./.pi/extensions/pi-goal/index.ts --list-models __pi_goal_load_check__",
    "test": "node --test test/**/*.test.cjs",
    "pack:dry": "npm pack --dry-run"
  },
  "author": "michaelliv",
  "contributors": [
    "Liucong-JunZi"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
